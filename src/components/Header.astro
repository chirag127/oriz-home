---
/*
 * Header — night-exchange chrome (2026-08-05 redesign).
 *
 * A sticky "control strip": the oriz.in call-sign wordmark on the left, a
 * mono routing nav in the center, and the Clerk AuthDock on the right (public-
 * first — signed-out shows an optional Sign in). A hairline beam sits under
 * the whole strip. Mobile collapses nav to the family drawer via the burger.
 */
import Wordmark from '~/components/Wordmark.astro'
import { FAMILY_SITES } from '~/lib/family'
import AuthDock from '~/components/AuthDock.tsx'

interface Props {
  /** When false, suppress the Clerk AuthDock island (one provider per page). */
  showAuth?: boolean
}
const { showAuth = true } = Astro.props

const dockSites = FAMILY_SITES.filter((s) => s.slug !== 'home').map((s) => ({
  slug: s.slug,
  name: s.name,
  url: s.url,
}))
---

<header class="hdr">
  <div class="spine hdr-row">
    <Wordmark size={22} href="https://oriz.in" />

    <nav class="hdr-nav" aria-label="Primary">
      <a href="/#board-a"><span class="hdr-dot" aria-hidden="true"></span>Sites</a>
      <a href="/#board-b"><span class="hdr-dot" aria-hidden="true"></span>APIs</a>
      <a href="/#board-c"><span class="hdr-dot" aria-hidden="true"></span>Packages</a>
      <a href="/about/"><span class="hdr-dot" aria-hidden="true"></span>About</a>
    </nav>

    <div class="hdr-right">
      {showAuth && <AuthDock client:only="react" sites={dockSites} />}
      <button
        class="hdr-burger"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        data-hdr-burger
      >
        <span class="hdr-burger-bar" aria-hidden="true"></span>
        <span class="hdr-burger-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in oklab, var(--oz-night) 88%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--oz-line);
  }
  .hdr::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, var(--oz-beam) 55%, transparent) 30%,
      color-mix(in oklab, var(--oz-amber) 55%, transparent) 70%,
      transparent
    );
    opacity: 0.7;
    pointer-events: none;
  }
  .hdr-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 60px;
  }

  .hdr-nav {
    display: flex;
    gap: 1.5rem;
    margin-left: 1.25rem;
  }
  .hdr-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--ink-mute);
    text-decoration: none;
    transition: color 0.18s;
  }
  .hdr-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--oz-line);
    transition: background 0.18s, box-shadow 0.18s;
  }
  .hdr-nav a:hover,
  .hdr-nav a:focus-visible {
    color: var(--ink);
    outline: none;
  }
  .hdr-nav a:hover .hdr-dot,
  .hdr-nav a:focus-visible .hdr-dot {
    background: var(--oz-beam);
    box-shadow: 0 0 8px var(--oz-beam);
  }
  .hdr-nav a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--oz-beam);
  }

  .hdr-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hdr-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    background: transparent;
    border: 1px solid var(--oz-line);
    width: 40px;
    height: 40px;
    border-radius: var(--md-shape-sm);
    cursor: pointer;
  }
  .hdr-burger-bar {
    width: 16px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
  }
  .hdr-burger:hover {
    border-color: var(--oz-beam);
  }
  .hdr-burger:hover .hdr-burger-bar {
    background: var(--oz-beam);
  }
  .hdr-burger:focus-visible {
    outline: 2px solid var(--oz-beam);
    outline-offset: 2px;
  }

  @media (max-width: 860px) {
    .hdr-nav {
      display: none;
    }
    .hdr-burger {
      display: inline-flex;
    }
  }
STYLE_MARKER_TEMP

<style is:global>
  /* AuthDock (Clerk React island) — scoped to a compact right-aligned control.
     Astro scoped styles can't reach the client:only island DOM, so global. */
  [data-dock] {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  [data-dock-signin] {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--oz-line);
    border-radius: var(--md-shape-sm);
    cursor: pointer;
    transition: border-color 0.18s, color 0.18s;
  }
  [data-dock-signin]:hover {
    border-color: var(--oz-beam);
    color: var(--oz-beam);
  }
  [data-dock-hint] {
    display: none;
  }
  [data-dock-account] {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  [data-dock-label] {
    color: var(--ink-mute);
    white-space: nowrap;
  }
  /* Pins panel: pop out of flow so it can't stretch the header row. */
  [data-dock-pins] {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(280px, 80vw);
    padding: 0.85rem 1rem;
    background: color-mix(in oklab, var(--oz-night) 96%, transparent);
    border: 1px solid var(--oz-line);
    border-radius: var(--md-shape-sm);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
    display: none;
    z-index: 60;
  }
  [data-dock]:hover [data-dock-pins],
  [data-dock]:focus-within [data-dock-pins] {
    display: block;
  }
  [data-dock-note] {
    margin: 0 0 0.5rem;
    color: var(--ink-mute);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  [data-dock-pinned] {
    list-style: none;
    margin: 0 0 0.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  [data-dock-pinned] a {
    color: var(--ink);
    text-decoration: none;
  }
  [data-dock-pinned] a:hover {
    color: var(--oz-beam);
  }
  [data-dock-editor] summary {
    cursor: pointer;
    color: var(--oz-beam);
    font-size: 0.75rem;
    list-style: none;
  }
  [data-dock-editor] summary::-webkit-details-marker {
    display: none;
  }
  [data-dock-editor] ul {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-height: 200px;
    overflow-y: auto;
  }
  [data-dock-editor] label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-mute);
    font-size: 0.75rem;
    cursor: pointer;
  }
  @media (max-width: 860px) {
    [data-dock-label] {
      display: none;
    }
    [data-dock-signin] {
      height: 32px;
      padding: 0 0.6rem;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-hdr-burger]')
  btn?.addEventListener('click', () => {
    const drawer = document.querySelector<HTMLInputElement>('#sb-toggle')
    if (drawer && 'checked' in drawer) {
      drawer.checked = !drawer.checked
      btn.setAttribute('aria-expanded', String(drawer.checked))
      return
    }
    document.getElementById('sb-toggle')?.scrollIntoView({ behavior: 'smooth' })
  })
</script>
