---
/*
 * Wordmark — `oriz.in` set as an exchange call-sign: Space Grotesk lower-case
 * `oriz`, a mono `.in` suffix, and a cyan signal-beam underscore that runs the
 * width of the mark. The beam IS the brand — a routing line at the exchange.
 *
 * Family-anchor asset. Sister sites may reuse the component and change the
 * optional `subtitle`:
 *   <Wordmark subtitle="blog" />   →  oriz.in / blog
 *   <Wordmark />                   →  oriz.in (bare)
 *
 * The beam appears at first paint — the one allowed accent occurrence in chrome.
 */

interface Props {
  /** Sub-section name — rendered after a `/` separator. */
  subtitle?: string
  /** Display size in CSS pixels. Defaults to 24 (chrome lockup). */
  size?: number
  /** Wrap in <a>. Defaults to the oriz root per the brief. */
  href?: string | null
  /** Render as <h1> for masthead use. */
  asHeading?: boolean
}

const { subtitle, size = 24, href = 'https://oriz.in', asHeading = false } = Astro.props
const Tag = asHeading ? 'h1' : ('div' as const)
const label = subtitle ? `oriz.in / ${subtitle}` : 'oriz.in'
---

{
  href ? (
    <a class="wm-link" href={href} aria-label={label}>
      <Tag class="wm" style={`--wm-size: ${size}px;`}>
        <span class="wm-mark">
          <span class="wm-root">oriz</span><span class="wm-tld">.in</span>
          <span class="wm-beam" aria-hidden="true" />
        </span>
        {subtitle && (
          <>
            <span class="wm-sep" aria-hidden="true">/</span>
            <span class="wm-sub">{subtitle}</span>
          </>
        )}
      </Tag>
    </a>
  ) : (
    <Tag class="wm" style={`--wm-size: ${size}px;`}>
      <span class="wm-mark">
        <span class="wm-root">oriz</span><span class="wm-tld">.in</span>
        <span class="wm-beam" aria-hidden="true" />
      </span>
      {subtitle && (
        <>
          <span class="wm-sep" aria-hidden="true">/</span>
          <span class="wm-sub">{subtitle}</span>
        </>
      )}
    </Tag>
  )
}

<style>
  .wm-link {
    display: inline-block;
    color: inherit;
    text-decoration: none;
    border-radius: var(--md-shape-xs);
  }
  .wm-link:focus-visible {
    outline: 2px solid var(--oz-beam);
    outline-offset: 3px;
  }
  .wm {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    margin: 0;
    font-size: var(--wm-size, 24px);
    line-height: 1;
    color: var(--ink);
  }
  .wm-mark {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    padding-bottom: 0.22em;
  }
  .wm-root {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .wm-tld {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.62em;
    color: var(--ink-mute);
    align-self: flex-end;
    padding-bottom: 0.06em;
  }
  /* The signal beam — a cyan routing line under the whole call-sign. */
  .wm-beam {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: max(2px, 0.09em);
    background: linear-gradient(90deg, var(--oz-beam), var(--oz-amber));
    border-radius: 999px;
    box-shadow: 0 0 8px color-mix(in oklab, var(--oz-beam) 55%, transparent);
    pointer-events: none;
  }
  .wm-link:hover .wm-beam {
    background: linear-gradient(90deg, var(--oz-amber), var(--oz-beam));
  }
  .wm-sep {
    font-family: var(--font-mono);
    color: var(--ink-mute);
    font-weight: 400;
  }
  .wm-sub {
    font-family: var(--font-display);
    color: var(--oz-amber);
    font-weight: 500;
  }
</style>
