---
/*
 * oriz.in — front door, rebuilt from scratch 2026-08-05 (night-exchange).
 *
 * THESIS: the hub is a live DEPARTURES BOARD at a night exchange. You do not
 * arrive to read a bio — you arrive to be routed onward. The page IS the board:
 * masthead call-sign, one split-flap line that flips to the live destination
 * count (the single orchestrated motion moment), then boards of departures by
 * line — Sites, APIs, Packages — each row a track with a call-sign, a
 * destination, and an ON TIME / LIVE lamp.
 *
 * Deliberately NOT the banned hero (big-name + stat-chips + gradient CTAs).
 * Numbering is real: rows carry sequential track numbers because the family IS
 * an enumerable destination set. Boldness spent on the board + beam; the rest
 * is quiet mono/typeset rows.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'

interface Row {
  callsign: string
  dest: string
  host: string
  url: string
  note: string
  lamp: 'live' | 'ontime'
}

const SITES: Row[] = [
  { callsign: 'PGS', dest: 'blog', host: 'blog.oriz.in', url: 'https://blog.oriz.in', note: "Engineer's notebook — dispatches.", lamp: 'live' },
  { callsign: 'ME', dest: 'me', host: 'me.oriz.in', url: 'https://me.oriz.in', note: 'Personal portfolio.', lamp: 'live' },
  { callsign: 'LOR', dest: 'lore', host: 'lore.oriz.in', url: 'https://lore.oriz.in', note: 'Lore — long-form reading.', lamp: 'ontime' },
  { callsign: 'NCE', dest: 'ncert', host: 'ncert.oriz.in', url: 'https://ncert.oriz.in', note: 'NCERT study notes.', lamp: 'ontime' },
  { callsign: 'CRD', dest: 'cards', host: 'cards.oriz.in', url: 'https://cards.oriz.in', note: 'Credit/debit card database.', lamp: 'ontime' },
  { callsign: 'FIN', dest: 'finance', host: 'finance.oriz.in', url: 'https://finance.oriz.in', note: 'India finance calculators.', lamp: 'live' },
  { callsign: 'LNK', dest: 'links', host: 'links.oriz.in', url: 'https://links.oriz.in', note: 'Curated dev links.', lamp: 'ontime' },
  { callsign: 'STS', dest: 'status', host: 'status.oriz.in', url: 'https://status.oriz.in', note: 'Services status board.', lamp: 'live' },
  { callsign: 'KNW', dest: 'knowledge', host: 'knowledge.oriz.in', url: 'https://knowledge.oriz.in', note: 'Knowledge base / second brain.', lamp: 'ontime' },
  { callsign: 'PLB', dest: 'portfolio-lab', host: 'portfolio-lab.oriz.in', url: 'https://portfolio-lab.oriz.in', note: 'Max-Sharpe portfolio studio.', lamp: 'live' },
  { callsign: 'ENV', dest: 'envpact', host: 'envpact.oriz.in', url: 'https://envpact.oriz.in', note: 'Sustainability dashboard.', lamp: 'ontime' },
  { callsign: 'IPO', dest: 'ipo', host: 'ipo.oriz.in', url: 'https://ipo.oriz.in', note: 'IPO grey-market-premium terminal.', lamp: 'live' },
  { callsign: 'MMI', dest: 'mmi', host: 'mmi.oriz.in', url: 'https://mmi.oriz.in', note: 'Tickertape Market Mood Index.', lamp: 'live' },
  { callsign: 'NFT', dest: 'nifty', host: 'nifty.oriz.in', url: 'https://nifty.oriz.in', note: 'Nifty buy-timing signal.', lamp: 'live' },
  { callsign: 'ACC', dest: 'account', host: 'account.oriz.in', url: 'https://account.oriz.in', note: 'Central sign-in / account.', lamp: 'live' },
]

const APIS: Row[] = [
  { callsign: 'RTO', dest: 'rto', host: 'api-rto.oriz.in', url: 'https://api-rto.oriz.in', note: 'RTO vehicle registration data.', lamp: 'live' },
  { callsign: 'CON', dest: 'constants', host: 'api-constants.oriz.in', url: 'https://api-constants.oriz.in', note: 'Indian constants + reference values.', lamp: 'ontime' },
  { callsign: 'DYN', dest: 'dynasties', host: 'api-dynasties.oriz.in', url: 'https://api-dynasties.oriz.in', note: 'Indian dynasties + historical data.', lamp: 'ontime' },
  { callsign: 'CP', dest: 'countries+', host: 'api-countries-plus.oriz.in', url: 'https://api-countries-plus.oriz.in', note: 'Country data, India-focused extras.', lamp: 'ontime' },
  { callsign: 'RAG', dest: 'ragas', host: 'api-ragas.oriz.in', url: 'https://api-ragas.oriz.in', note: 'Hindustani + Carnatic raga database.', lamp: 'ontime' },
  { callsign: 'AQI', dest: 'air-quality', host: 'api-air-quality.oriz.in', url: 'https://api-air-quality.oriz.in', note: 'Live AQI for Indian cities.', lamp: 'live' },
  { callsign: 'FX', dest: 'currency', host: 'api-currency-rates.oriz.in', url: 'https://api-currency-rates.oriz.in', note: 'Live currency exchange rates.', lamp: 'live' },
  { callsign: 'FLW', dest: 'fii-dii', host: 'api-fii-dii.oriz.in', url: 'https://api-fii-dii.oriz.in', note: 'FII + DII daily investment flows.', lamp: 'live' },
  { callsign: 'AU', dest: 'gold-silver', host: 'api-gold-silver.oriz.in', url: 'https://api-gold-silver.oriz.in', note: 'Live gold + silver prices (India).', lamp: 'live' },
  { callsign: 'FSC', dest: 'ifsc', host: 'api-ifsc.oriz.in', url: 'https://api-ifsc.oriz.in', note: 'IFSC lookup for bank branches.', lamp: 'ontime' },
  { callsign: 'BUD', dest: 'budget', host: 'api-budget.oriz.in', url: 'https://api-budget.oriz.in', note: 'Union Budget allocations.', lamp: 'ontime' },
  { callsign: 'HOL', dest: 'holidays', host: 'api-holidays.oriz.in', url: 'https://api-holidays.oriz.in', note: 'Public holidays by state + year.', lamp: 'ontime' },
  { callsign: 'PD', dest: 'petrol-diesel', host: 'api-petrol-diesel.oriz.in', url: 'https://api-petrol-diesel.oriz.in', note: 'Daily petrol + diesel by city.', lamp: 'live' },
  { callsign: 'TRN', dest: 'train-sched', host: 'api-train-schedules.oriz.in', url: 'https://api-train-schedules.oriz.in', note: 'Indian Railways schedules.', lamp: 'ontime' },
  { callsign: 'WX', dest: 'weather', host: 'api-weather.oriz.in', url: 'https://api-weather.oriz.in', note: 'Current weather for Indian cities.', lamp: 'live' },
  { callsign: 'MMI', dest: 'mmi', host: 'api-mmi-tickertape.oriz.in', url: 'https://api-mmi-tickertape.oriz.in', note: 'Market Mood Index + Tickertape.', lamp: 'live' },
]

const PKG_SLUGS = [
  'md3-tokens', 'astro-seo', 'astro-analytics', 'astro-chrome', 'astro-shell',
  'astro-billing', 'astro-content', 'astro-data', 'astro-forms', 'astro-pwa',
  'astro-tools', 'astro-widgets', 'auth-core', 'omni-publish', 'ai-providers',
  'seo', 'rate-limit',
]

const totalDest = SITES.length + APIS.length + PKG_SLUGS.length
const liveNow = [...SITES, ...APIS].filter((r) => r.lamp === 'live').length

const boards: { code: string; line: string; label: string; rows: Row[] }[] = [
  { code: 'A', line: 'sites', label: 'Sites', rows: SITES },
  { code: 'B', line: 'apis', label: 'API fleet', rows: APIS },
]
---

<BaseLayout
  title="oriz.in — the exchange · route to every free app, tool, book & API"
  description="oriz.in is the front door to a free-forever family of small web apps, tools, content sites, books and open-source packages by Chirag Singhal. Pick a destination."
  sidebar={false}
>
  <div class="exchange">

    <header class="board-head spine" aria-label="Exchange">
      <p class="bh-eyebrow"><span class="bh-lamp" aria-hidden="true"></span>Now boarding · night exchange</p>

      <div class="bh-flap">
        <span class="bh-flap-label">Destinations live</span>
        <span class="bh-flap-count" data-flip data-target={totalDest} aria-label={`${totalDest} destinations`}>00</span>
        <span class="bh-flap-sub">{liveNow} updating in real time</span>
      </div>

      <h1 class="bh-title">One board. <span class="bh-em">Every</span> destination.</h1>
      <p class="bh-lede">
        oriz.in routes onward to a free-forever family — apps, tools, books, live data APIs
        and open packages. Read the board, pick a line, depart. Nothing here is gated.
      </p>

      <a class="bh-depart" href="#board-a">
        <span>Read the board</span>
        <span class="bh-depart-beam" aria-hidden="true"></span>
      </a>
    </header>

    {boards.map((b) => (
      <section class="board spine" id={`board-${b.code.toLowerCase()}`} aria-label={b.label}>
        <header class="board-strip">
          <span class="bs-line" data-line={b.line}>Line {b.code}</span>
          <h2 class="bs-label">{b.label}</h2>
          <span class="bs-count">{String(b.rows.length).padStart(2, '0')} destinations</span>
        </header>

        <ol class="deps" role="list">
          {b.rows.map((r, i) => (
            <li class="dep-row" data-lamp={r.lamp}>
              <a class="dep" href={r.url}>
                <span class="dep-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="dep-cs" aria-hidden="true">{r.callsign}</span>
                <span class="dep-body">
                  <span class="dep-dest">{r.dest}</span>
                  <span class="dep-note">{r.note}</span>
                </span>
                <span class="dep-host">{r.host}</span>
                <span class="dep-lamp" aria-hidden="true">
                  <span class="dep-dot"></span>{r.lamp === 'live' ? 'LIVE' : 'ON TIME'}
                </span>
                <span class="dep-go" aria-hidden="true">&#8599;</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <section class="board spine" id="board-c" aria-label="Packages">
      <header class="board-strip">
        <span class="bs-line" data-line="packages">Line C</span>
        <h2 class="bs-label">npm packages</h2>
        <span class="bs-count">@chirag127 · {String(PKG_SLUGS.length).padStart(2, '0')}</span>
      </header>
      <ul class="pk-strip" role="list">
        {PKG_SLUGS.map((slug) => (
          <li>
            <a class="pk" href={`https://npm.im/@chirag127/${slug}`}>
              <span class="pk-ns">@chirag127/</span><span class="pk-name">{slug}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="concourse spine" aria-label="About the exchange">
      <p class="cc-copy">
        Built + run by <a href="https://me.oriz.in">Chirag Singhal</a> — one operator,
        {totalDest} public destinations, no ads, no paywalls, no card on file.
      </p>
      <div class="cc-links">
        <a href="https://github.com/chirag127">github.com/chirag127</a>
        <a href="/about/">About</a>
        <a href="/sites/">Full index</a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .exchange { padding-bottom: clamp(3rem, 8vw, 6rem); }

  /* ── MASTHEAD ─────────────────────────────────────────────────────── */
  .board-head {
    padding-block: clamp(3rem, 9vw, 6.5rem) clamp(2.5rem, 6vw, 4rem);
    position: relative;
  }
  .bh-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 clamp(1.5rem, 4vw, 2.25rem);
  }
  .bh-lamp {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--oz-amber);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--oz-amber) 70%, transparent);
    animation: lamp-pulse 2.4s ease-out infinite;
  }
  @keyframes lamp-pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in oklab, var(--oz-amber) 70%, transparent); }
    70%  { box-shadow: 0 0 0 8px color-mix(in oklab, var(--oz-amber) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--oz-amber) 0%, transparent); }
  }

  /* Split-flap count — signature motion moment. */
  .bh-flap {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 1.25rem;
    margin-bottom: clamp(1.75rem, 5vw, 2.75rem);
    width: max-content;
    max-width: 100%;
  }
  .bh-flap-label {
    grid-column: 1; grid-row: 1;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    align-self: end;
    padding-bottom: 0.5rem;
  }
  .bh-flap-count {
    grid-column: 1; grid-row: 2;
    font-family: var(--font-mono);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    font-size: clamp(3.5rem, 13vw, 6.5rem);
    line-height: 0.86;
    color: var(--oz-halo);
    background: linear-gradient(180deg, var(--oz-night-3), var(--oz-night-2));
    border: 1px solid var(--oz-line);
    border-radius: var(--md-shape-md);
    padding: 0.12em 0.28em 0.16em;
    position: relative;
    box-shadow: inset 0 -6px 12px rgba(0,0,0,0.35), 0 0 24px color-mix(in oklab, var(--oz-beam) 12%, transparent);
  }
  .bh-flap-count::after {
    content: '';
    position: absolute;
    left: 0.28em; right: 0.28em;
    top: 50%;
    height: 2px;
    transform: translateY(-1px);
    background: var(--oz-night);
    opacity: 0.75;
  }
  .bh-flap-sub {
    grid-column: 2; grid-row: 2;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--oz-amber);
    max-width: 12ch;
    line-height: 1.35;
  }

  .bh-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 7.5vw, 5.25rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--oz-halo);
    margin: 0 0 clamp(1rem, 3vw, 1.5rem);
    max-width: 16ch;
  }
  .bh-em { color: var(--oz-beam); position: relative; }
  .bh-em::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    bottom: 0.06em;
    height: max(3px, 0.08em);
    background: linear-gradient(90deg, var(--oz-beam), var(--oz-amber));
    border-radius: 999px;
    box-shadow: 0 0 10px color-mix(in oklab, var(--oz-beam) 55%, transparent);
  }
  .bh-lede {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2.2vw, 1.1875rem);
    line-height: 1.6;
    color: var(--ink-mute);
    max-width: 54ch;
    margin: 0 0 clamp(1.75rem, 4vw, 2.5rem);
  }
  .bh-depart {
    display: inline-flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--oz-halo);
    text-decoration: none;
    width: max-content;
  }
  .bh-depart-beam {
    height: 2px; width: 100%;
    background: var(--oz-line);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }
  .bh-depart-beam::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(90deg, var(--oz-beam), var(--oz-amber));
    transform: translateX(-100%);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .bh-depart:hover .bh-depart-beam::after,
  .bh-depart:focus-visible .bh-depart-beam::after { transform: translateX(0); }
  .bh-depart:focus-visible { outline: 2px solid var(--oz-beam); outline-offset: 4px; border-radius: 4px; }

  /* ── BOARD SECTIONS ───────────────────────────────────────────────── */
  .board { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .board-strip {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--oz-line);
    margin-bottom: 0.25rem;
  }
  .bs-line {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--oz-night);
    background: var(--oz-beam);
    padding: 0.28em 0.6em;
    border-radius: var(--md-shape-xs);
  }
  .bs-line[data-line='apis'] { background: var(--oz-amber); }
  .bs-line[data-line='packages'] { background: var(--oz-rose); }
  .bs-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    letter-spacing: -0.015em;
    color: var(--oz-halo);
    margin: 0;
    margin-right: auto;
  }
  .bs-count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
    white-space: nowrap;
  }

  .deps { list-style: none; margin: 0; padding: 0; }
  .dep-row + .dep-row { border-top: 1px solid color-mix(in oklab, var(--oz-line) 55%, transparent); }
  .dep {
    display: grid;
    grid-template-columns: 2.5rem 3.25rem 1fr auto auto 1.25rem;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 0.5rem;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: background 0.16s;
  }
  .dep::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: transparent;
    transition: background 0.16s;
  }
  .dep:hover, .dep:focus-visible { background: var(--oz-night-2); outline: none; }
  .dep:hover::before, .dep:focus-visible::before {
    background: linear-gradient(180deg, var(--oz-beam), var(--oz-amber));
  }
  .dep:focus-visible { box-shadow: inset 0 0 0 1px var(--oz-beam); border-radius: var(--md-shape-sm); }
  .dep-no {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-mute);
    font-variant-numeric: tabular-nums;
  }
  .dep-cs {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--oz-halo);
    background: var(--oz-night-3);
    border: 1px solid var(--oz-line);
    border-radius: var(--md-shape-xs);
    padding: 0.3em 0;
    text-align: center;
  }
  .dep-body { min-width: 0; }
  .dep-dest {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--oz-halo);
    letter-spacing: -0.01em;
  }
  .dep:hover .dep-dest, .dep:focus-visible .dep-dest { color: var(--oz-beam); }
  .dep-note {
    display: block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--ink-mute);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dep-host {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-mute);
    white-space: nowrap;
  }
  .dep-lamp {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--ink-mute);
    white-space: nowrap;
  }
  .dep-dot { width: 6px; height: 6px; border-radius: 999px; background: var(--ink-mute); }
  .dep-row[data-lamp='live'] .dep-dot {
    background: var(--oz-amber);
    box-shadow: 0 0 6px var(--oz-amber);
    animation: lamp-pulse 2.4s ease-out infinite;
  }
  .dep-row[data-lamp='live'] .dep-lamp { color: var(--oz-amber); }
  .dep-row[data-lamp='ontime'] .dep-dot { background: var(--oz-beam); }
  .dep-go {
    font-family: var(--font-mono);
    color: var(--ink-mute);
    text-align: right;
    transition: transform 0.16s, color 0.16s;
  }
  .dep:hover .dep-go, .dep:focus-visible .dep-go { color: var(--oz-beam); transform: translate(2px, -2px); }

  /* ── PACKAGES STRIP ───────────────────────────────────────────────── */
  .pk-strip {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pk {
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    padding: 0.5em 0.85em;
    border: 1px solid var(--oz-line);
    border-radius: var(--md-shape-full);
    background: var(--oz-night-2);
    transition: border-color 0.16s, background 0.16s;
  }
  .pk-ns { color: var(--ink-mute); }
  .pk-name { color: var(--oz-halo); }
  .pk:hover, .pk:focus-visible { border-color: var(--oz-rose); background: var(--oz-night-3); outline: none; }
  .pk:hover .pk-name, .pk:focus-visible .pk-name { color: var(--oz-rose); }
  .pk:focus-visible { box-shadow: 0 0 0 2px color-mix(in oklab, var(--oz-rose) 50%, transparent); }

  /* ── CONCOURSE ────────────────────────────────────────────────────── */
  .concourse {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: clamp(1.5rem, 4vw, 2rem);
    border-top: 1px solid var(--oz-line);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .cc-copy {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--ink-mute);
    margin: 0;
    max-width: 52ch;
  }
  .cc-copy a { color: var(--oz-beam); }
  .cc-links { display: flex; gap: 1.25rem; }
  .cc-links a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    text-decoration: none;
  }
  .cc-links a:hover, .cc-links a:focus-visible { color: var(--oz-halo); }

  /* ── RESPONSIVE ───────────────────────────────────────────────────── */
  @media (max-width: 760px) {
    .dep {
      grid-template-columns: 2rem 2.75rem 1fr auto;
      gap: 0.7rem;
      row-gap: 0.35rem;
    }
    .dep-host { display: none; }
    .dep-lamp { grid-column: 3 / 5; justify-content: flex-start; }
    .dep-note { white-space: normal; }
  }
  @media (max-width: 460px) {
    .bh-flap { grid-template-columns: 1fr; }
    .bh-flap-sub { grid-column: 1; grid-row: 3; max-width: none; margin-top: 0.5rem; }
  }

  /* ── REDUCED MOTION ───────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .bh-lamp, .dep-row[data-lamp='live'] .dep-dot { animation: none; }
    .bh-depart-beam::after { transition: none; }
    .dep-go { transition: none; }
  }
</style>

<script>
  /* Split-flap count-up — the one orchestrated motion moment. Honors
     prefers-reduced-motion (snaps to target). */
  const el = document.querySelector<HTMLElement>('[data-flip]')
  if (el) {
    const target = Number(el.dataset.target ?? '0')
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduce || target <= 0) {
      el.textContent = String(target).padStart(2, '0')
    } else {
      const run = () => {
        const dur = 1100
        const t0 = performance.now()
        const tick = (now: number) => {
          const p = Math.min(1, (now - t0) / dur)
          const eased = 1 - (1 - p) ** 3
          const val = p < 1 ? Math.floor(eased * target + (1 - eased) * (Math.random() * target)) : target
          el.textContent = String(Math.min(target, val)).padStart(2, '0')
          if (p < 1) requestAnimationFrame(tick)
          else el.textContent = String(target).padStart(2, '0')
        }
        requestAnimationFrame(tick)
      }
      const io = new IntersectionObserver((entries, obs) => {
        for (const e of entries) if (e.isIntersecting) { run(); obs.disconnect() }
      }, { threshold: 0.4 })
      io.observe(el)
    }
  }
</script>
